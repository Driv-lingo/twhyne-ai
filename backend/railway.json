{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["python311"]
        },
        "install": {
          "cmds": ["pip install -r requirements.txt"]
        }
      },
      "start": {
        "cmd": "python3 license_api_server.py"
      }
    }
  },
  "deploy": {
    "startCommand": "python3 license_api_server.py",
    "healthcheckPath": "/api/status",
    "restartPolicyType": "ON_FAILURE"
  }
}
