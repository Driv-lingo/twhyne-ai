  "code": [
    {"id": "c1", "prompt": "Write a Python function called is_even that returns True if a number is even.", "unit_tests": ["assert is_even(4) is True", "assert is_even(7) is False", "assert is_even(0) is True", "assert is_even(-2) is True"], "expect_node": "code-codellama-7b"},
    {"id": "c2", "prompt": "Write a Python function called reverse_string that reverses a string.", "unit_tests": ["assert reverse_string('hello') == 'olleh'", "assert reverse_string('') == ''", "assert reverse_string('a') == 'a'"], "expect_node": "code-codellama-7b"},
    {"id": "c3", "prompt": "Write a Python function fizzbuzz(n) that returns 'Fizz' for multiples of 3, 'Buzz' for multiples of 5, and 'FizzBuzz' for multiples of both.", "unit_tests": ["assert fizzbuzz(15) == 'FizzBuzz'", "assert fizzbuzz(9) == 'Fizz'", "assert fizzbuzz(10) == 'Buzz'", "assert fizzbuzz(7) in ('7', 7)", "assert fizzbuzz(30) == 'FizzBuzz'"], "expect_node": "code-codellama-7b"},
    {"id": "c4", "prompt": "Write a Python function called is_palindrome that checks if a string is a palindrome (case-insensitive).", "unit_tests": ["assert is_palindrome('racecar') is True", "assert is_palindrome('') is True", "assert is_palindrome('Racecar') is True", "assert is_palindrome('hello') is False"], "expect_node": "code-codellama-7b"},
    {"id": "c5", "prompt": "Write a Python function called factorial that returns the factorial of a non-negative integer.", "unit_tests": ["assert factorial(0) == 1", "assert factorial(1) == 1", "assert factorial(5) == 120"], "expect_node": "code-codellama-7b"},
    {"id": "c6", "prompt": "Write a Python function called find_max that finds the largest value in a list without using the built-in max function.", "unit_tests": ["assert find_max([3, 1, 4, 1, 5]) == 5", "assert find_max([-7, -2, -9]) == -2", "assert find_max([42]) == 42"], "expect_node": "code-codellama-7b"},
    {"id": "c7", "prompt": "Write a Python function called count_vowels that counts the vowels in a string.", "unit_tests": ["assert count_vowels('hello world') == 3", "assert count_vowels('') == 0", "assert count_vowels('xyz') == 0"], "expect_node": "code-codellama-7b"},
    {"id": "c8", "prompt": "Write a Python function called celsius_to_fahrenheit that converts Celsius to Fahrenheit.", "unit_tests": ["assert celsius_to_fahrenheit(0) == 32", "assert celsius_to_fahrenheit(100) == 212", "assert celsius_to_fahrenheit(-40) == -40"], "expect_node": "code-codellama-7b"},
    {"id": "c9", "prompt": "Write a Python function called binary_search that performs binary search on a sorted list and returns True if the item is present.", "unit_tests": ["assert binary_search([1, 3, 5, 7], 5) is True", "assert binary_search([1, 3, 5, 7], 4) is False", "assert binary_search([9], 9) is True", "assert binary_search([], 1) is False"], "expect_node": "code-codellama-7b"},
    {"id": "c10", "prompt": "Write a Python function called sum_even that returns the total of all even numbers in a list.", "unit_tests": ["assert sum_even([1, 2, 3, 4]) == 6", "assert sum_even([]) == 0", "assert sum_even([1, 3, 5]) == 0", "assert sum_even([-2, 2]) == 0"], "expect_node": "code-codellama-7b"}
